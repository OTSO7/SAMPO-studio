{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAMPO Studio",
  "version": "0.4.2",
  "identifier": "fi.routa.sampo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAMPO Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "backgroundColor": "#090A0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMDM3MDU0MURFRkQ1NjgKUldSbzFlOGRWSEFEeW53dGpPSDdpRlpmOTVqUW9ZWjRXVk9UbEVENVhUQ2x5QW1tOW9CeldyTzMK",
      "endpoints": ["https://github.com/OTSO7/SAMPO-studio/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "publisher": "SAMPO Studio",
    "copyright": "© 2026 SAMPO Studio",
    "category": "Productivity",
    "shortDescription": "Story and dialogue boards for game teams",
    "longDescription": "SAMPO Studio turns story documents into a storyboard of phases, cards and dialogue that game teams can plan, edit and present together.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["sampo"],
        "name": "SAMPO Story",
        "description": "SAMPO story",
        "role": "Editor",
        "mimeType": "application/x-sampo-story"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
